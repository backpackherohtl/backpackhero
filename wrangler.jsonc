// Cloudflare-Konfiguration für die Website von Backpack Hero.
// Hier stehen keine Geheimnisse: Datenbank-ID, Access-Domain und AUD-Tag sind öffentlich unbedenklich.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backpackhero",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-27",
  // Nur noch über backpackhero.at erreichbar, keine workers.dev- oder Vorschau-Adressen
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Der Worker läuft immer zuerst (Login-Prüfung für Admin, Weiterleitung von www)
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "backpackhero",
      // Datenbank im Cloudflare-Dashboard (Storage & Databases → D1)
      "database_id": "79bf4e01-3eeb-4e25-91e3-421fbf5b9923"
    }
  ],
  "vars": {
    // Cloudflare Access: Team-Domain (z. B. backpackhero.cloudflareaccess.com) und AUD-Tag der Admin-Anwendung.
    // Solange leer, ist der Admin-Bereich komplett gesperrt.
    // Mehrere Team-Domains mit Komma trennen
    "ACCESS_TEAM_DOMAIN": "backpackhero.cloudflareaccess.com",
    // AUD-Tag der Access-App „backpackhero.at“ (/admin und /api/admin). Mehrere mit Komma trennen
    "ACCESS_AUD": "38e08c6ff1c69345edba0922a554c7084d49117b34e90ac4c8c889c70b7bae16",
    // Benachrichtigungen: Absender auf unserer Domain, Empfänger ist eine bestätigte Adresse im Email Routing
    "NOTIFY_TO": "backpackherohtl@gmail.com",
    "MAIL_FROM": "info@backpackhero.at"
  },
  // Mailversand nur an unser eigenes Postfach (Bestellungen, Wochenzusammenfassung)
  "send_email": [{ "name": "MAILER", "destination_address": "backpackherohtl@gmail.com" }],
  // Montag 7:00 UTC = 8:00 Winterzeit / 9:00 Sommerzeit in Wien: Wochenmail. Täglich 3:00 UTC: Aufräumen
  "triggers": { "crons": ["0 7 * * 1", "0 3 * * *"] },
  "observability": { "enabled": true }
}
