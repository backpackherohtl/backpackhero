// Cloudflare-Konfiguration für die Website von Backpack Hero.
// Hier stehen keine Geheimnisse: Datenbank-ID, Access-Domain und AUD-Tag sind öffentlich unbedenklich.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backpackhero",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Für Admin und Schnittstellen läuft immer zuerst der Worker (Login-Prüfung)
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "backpackhero",
      // Datenbank im Cloudflare-Dashboard (Storage & Databases → D1)
      "database_id": "79bf4e01-3eeb-4e25-91e3-421fbf5b9923"
    }
  ],
  "vars": {
    // Cloudflare Access: Team-Domain (z. B. backpackhero.cloudflareaccess.com) und AUD-Tag der Admin-Anwendung.
    // Solange leer, ist der Admin-Bereich komplett gesperrt.
    // Mehrere Team-Domains mit Komma trennen (alter Name bis zur Bestätigung drin)
    "ACCESS_TEAM_DOMAIN": "backpackhero.cloudflareaccess.com,small-wildflower-9b1f.cloudflareaccess.com",
    // Mehrere AUD-Tags mit Komma trennen (workers.dev und später backpackhero.at)
    "ACCESS_AUD": "90cba56a5d2b5a7291f42c2e7090e2688166545e50a56130b05ba563e5bd2de5",
    // Benachrichtigungen (funktionieren erst, wenn die Domain bei Cloudflare ist und Email Routing läuft)
    "NOTIFY_TO": "backpackherohtl@gmail.com",
    "MAIL_FROM": ""
  },
  // Montag 7:00 UTC = 8:00 Winterzeit / 9:00 Sommerzeit in Wien
  "triggers": { "crons": ["0 7 * * 1"] },
  "observability": { "enabled": true }
}
